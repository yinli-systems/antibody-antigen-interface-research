* text=auto

*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sbatch text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.tsv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.patch text eol=lf -whitespace

*.jpg binary
*.jpeg binary
*.png binary

# Large line-oriented evidence remains reviewable but is collapsed by default.
protocols/**/*.jsonl linguist-generated=true
protocols/**/*.tsv linguist-generated=true
results/**/*.jsonl linguist-generated=true
results/**/*.tsv linguist-generated=true

# Preserve original CSV bytes bound by the MIPE recovery SHA-256 receipts.
results/mipe_contact_threshold_diagnostic_v1/MIPE_CONTACT_THRESHOLD_PER_COMPLEX.csv -text
results/mipe_paper_track_fixed05_recovery_v1/MIPE_PAPER_TRACK_FIXED05_METRICS.csv -text
results/mipe_paper_track_fixed05_recovery_v1/MIPE_PAPER_TRACK_FIXED05_PER_COMPLEX.csv -text
