* text=auto

*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sbatch text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.tsv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.jpg binary
*.jpeg binary
*.png binary

# Large line-oriented evidence remains reviewable but is collapsed by default.
protocols/**/*.jsonl linguist-generated=true
protocols/**/*.tsv linguist-generated=true
results/**/*.jsonl linguist-generated=true
results/**/*.tsv linguist-generated=true
