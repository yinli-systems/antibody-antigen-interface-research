* text=auto

*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sbatch text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.tsv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.patch text eol=lf -whitespace

*.jpg binary
*.jpeg binary
*.png binary

# Large line-oriented evidence remains reviewable but is collapsed by default.
protocols/**/*.jsonl linguist-generated=true
protocols/**/*.tsv linguist-generated=true
results/**/*.jsonl linguist-generated=true
results/**/*.tsv linguist-generated=true

# Preserve original CSV bytes bound by the MIPE recovery SHA-256 receipts.
results/mipe_contact_threshold_diagnostic_v1/MIPE_CONTACT_THRESHOLD_PER_COMPLEX.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/mipe_paper_track_fixed05_recovery_v1/MIPE_PAPER_TRACK_FIXED05_METRICS.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/mipe_paper_track_fixed05_recovery_v1/MIPE_PAPER_TRACK_FIXED05_PER_COMPLEX.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Generated navigation is collapsed, while handwritten cards/curation remain reviewable.
results/atlas/branches/*.md linguist-generated=true
results/atlas/families/*.md linguist-generated=true
results/atlas/index.html linguist-generated=true
results/atlas/FILE_VERSIONS.jsonl.gz binary
results/atlas/VERIFICATION.json linguist-generated=true

# Exact archived terminal bytes are evidence, not formatted source.
results/integration_20261007/validation/*.log -text -whitespace
archive/branch_variants_20261007/**/data/* -text
