# Copy to .env. Never commit real keys.
ABCITE_PROVIDER=auto
ABCITE_LOG_LEVEL=INFO
ABCITE_ABSTAIN_THRESHOLD=0.12
ABCITE_HITL_HIGH_STAKES=1
ABCITE_RCSB_LIVE=0

# Optional tracing (LANGCHAIN_API_KEY also accepted)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT=abcite

# Optional cloud LLMs / vision (auto-selected when keys are set)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AWS_REGION=eu-west-2
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
