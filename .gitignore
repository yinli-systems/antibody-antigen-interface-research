# Raw cluster telemetry stays local; compact audits and receipts remain eligible.
/results/**/*.out
/results/**/*.err
/results/**/gpu.csv

# The compact audited result is publishable; the full per-pair prediction dump is not.
/results/sabdab2_frozen_ensemble_test_v1/SABDAB2_FRAMECONTACT_FROZEN_ENSEMBLE_TEST_FULL.json

# Paper-local compact metric and reference audits are source artifacts, not datasets.
!/paper/neurips_2026_framecontact/data/
!/paper/neurips_2026_framecontact/data/*.json

# Explicitly retained, hash-bound evidence must not be omitted from clean clones.
!archive/branch_variants_20261007/*/paper/neurips_2026_framecontact/data/
!archive/branch_variants_20261007/*/paper/neurips_2026_framecontact/data/*
!results/integration_20261007/validation/*.log
