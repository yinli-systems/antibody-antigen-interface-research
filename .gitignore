# Codex-local render and recovery workspaces are never research artifacts.
/.codex_tmp/
/.codex_work/

# Explicitly local research notes retain their stated storage boundary.
/research/teacher_shock_sprint_20260824/

# Prospective wet-lab blinding keys, arm mappings, and unreleased candidate payloads.
/research/prospective_epitope_design_v1/private/

# Local orchestration scratch space and rendered review artifacts.
/output/
/tmp/
/paper/neurips_2026_framecontact/__pycache__/
/paper/neurips_2026_framecontact/build/
/paper/neurips_2026_framecontact/render/
/paper/neurips_2026_framecontact/render_updated/
