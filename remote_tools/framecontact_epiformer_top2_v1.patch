+def masked_top_k_mean_probability_logits(
+    logits: Any, mask: Any, *, dim: int, k: int = 2
+) -> Any:
+    """Pool the top-k observed contact probabilities and return stable logits."""
+    torch_module = _require_torch()
+    if tuple(logits.shape) != tuple(mask.shape) or mask.dtype != torch_module.bool:
+        raise ValueError("logits and boolean mask must have identical shapes")
+    k = _positive_integer(k, "k")
+    top_k = min(k, int(logits.shape[dim]))
+    probabilities = torch_module.sigmoid(logits.float()).masked_fill(~mask, 0.0)
+    values = torch_module.topk(
+        probabilities, k=top_k, dim=dim, largest=True, sorted=False
+    ).values
+    observed_count = mask.sum(dim=dim)
+    denominator = observed_count.clamp(min=1, max=top_k).to(values.dtype)
+    pooled = values.sum(dim=dim) / denominator
+    epsilon = torch_module.finfo(pooled.dtype).eps
+    pooled_logits = torch_module.logit(pooled.clamp(epsilon, 1.0 - epsilon))
+    pooled_logits = pooled_logits.to(logits.dtype)
+    return pooled_logits.masked_fill(observed_count == 0, 0.0)
+
