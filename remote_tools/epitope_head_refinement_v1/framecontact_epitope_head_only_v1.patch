+def _state_sha256_excluding(
+    model: torch.nn.Module, excluded_prefixes: tuple[str, ...]
+) -> str:
+    digest = hashlib.sha256()
+    for name, tensor in model.state_dict().items():
+        if any(name == prefix or name.startswith(f"{prefix}.") for prefix in excluded_prefixes):
+            continue
+        value = tensor.detach().cpu().contiguous()
+        digest.update(name.encode())
+        digest.update(str(value.dtype).encode())
+        digest.update(str(tuple(value.shape)).encode())
+        digest.update(value.numpy().tobytes())
+    return digest.hexdigest()
+
+
+def _configure_training_policy(
+    model: FrameContactModel, training_policy: str
+) -> tuple[str, ...]:
+    if training_policy == "full":
+        return tuple(name for name, parameter in model.named_parameters() if parameter.requires_grad)
+    if training_policy != "epitope_head_only":
+        raise ValueError("Unsupported training policy")
+    for parameter in model.parameters():
+        parameter.requires_grad_(False)
+    for parameter in model.epitope_head.parameters():
+        parameter.requires_grad_(True)
+    names = tuple(name for name, parameter in model.named_parameters() if parameter.requires_grad)
+    expected = ("epitope_head.weight", "epitope_head.bias")
+    if names != expected:
+        raise RuntimeError(f"Unexpected head-only trainable parameters: {names}")
+    return names
+
+
+def _set_training_mode(model: FrameContactModel, training_policy: str) -> None:
+    if training_policy == "epitope_head_only":
+        model.eval()
+        model.epitope_head.train()
+    else:
+        model.train()
+
+
