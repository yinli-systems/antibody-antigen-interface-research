+def hard_negative_pair_ranking_loss_per_complex(
+    logits: Any,
+    labels: Any,
+    mask: Any,
+    *,
+    negative_fraction: float = 0.01,
+    maximum_pairs: int = 64,
+    margin: float = 0.5,
+) -> Any:
+    """Rank each complex's hardest negative pairs below its weakest positives."""
+    torch_module = _require_torch()
+    if (
+        tuple(logits.shape) != tuple(labels.shape)
+        or tuple(logits.shape) != tuple(mask.shape)
+        or mask.dtype != torch_module.bool
+    ):
+        raise ValueError("hard-negative logits, labels, and mask must align")
+    if not math.isfinite(float(negative_fraction)) or not 0 < negative_fraction <= 1:
+        raise ValueError("hard-negative fraction must lie in (0, 1]")
+    if maximum_pairs < 1:
+        raise ValueError("hard-negative maximum pairs must be positive")
+    if not math.isfinite(float(margin)) or margin < 0:
+        raise ValueError("hard-negative margin must be finite and nonnegative")
+    losses = []
+    for batch_index in range(int(logits.shape[0])):
+        local_logits = logits[batch_index][mask[batch_index]].float()
+        local_labels = labels[batch_index][mask[batch_index]]
+        positive = local_logits[local_labels == 1]
+        negative = local_logits[local_labels == 0]
+        if positive.numel() == 0 or negative.numel() == 0:
+            losses.append(local_logits.sum() * 0.0)
+            continue
+        negative_count = min(
+            int(maximum_pairs),
+            max(1, math.ceil(float(negative_fraction) * int(negative.numel()))),
+        )
+        positive_count = min(int(maximum_pairs), int(positive.numel()))
+        hard_negative = torch_module.topk(
+            negative, k=negative_count, largest=True
+        ).values
+        weak_positive = torch_module.topk(
+            positive, k=positive_count, largest=False
+        ).values
+        pairwise_margin = (
+            float(margin)
+            + hard_negative[:, None]
+            - weak_positive[None, :]
+        )
+        losses.append(functional.softplus(pairwise_margin).mean())
+    return torch_module.stack(losses).mean()
+
