+def chain_internal_ca_surface_score(
+    backbone: Any,
+    residue_mask: Any,
+    chain_ids: Any,
+    *,
+    radius: float = 10.0,
+) -> Any:
+    """Estimate residue exposure from chain-internal predicted C-alpha density.
+
+    The score is standardized independently within each physical chain. Lower
+    local C-alpha density receives a larger (more surface-like) score. No
+    cross-partner coordinates or labels are used.
+    """
+    torch_module = _require_torch()
+    if (
+        not torch_module.is_tensor(backbone)
+        or tuple(backbone.shape[-2:]) != (3, 3)
+        or not torch_module.is_tensor(residue_mask)
+        or residue_mask.dtype != torch_module.bool
+        or tuple(residue_mask.shape) != tuple(backbone.shape[:2])
+        or not torch_module.is_tensor(chain_ids)
+        or tuple(chain_ids.shape) != tuple(residue_mask.shape)
+        or torch_module.is_floating_point(chain_ids)
+    ):
+        raise ValueError("surface-score inputs must align on the residue axis")
+    if not math.isfinite(float(radius)) or float(radius) <= 0.0:
+        raise ValueError("surface radius must be finite and positive")
+    ca = backbone[..., 1, :].to(torch_module.float32)
+    valid = residue_mask & torch_module.isfinite(ca).all(dim=-1)
+    safe_ca = torch_module.where(valid[..., None], ca, 0.0)
+    distances = torch_module.cdist(safe_ca, safe_ca)
+    same_chain = chain_ids[:, :, None] == chain_ids[:, None, :]
+    pair_valid = valid[:, :, None] & valid[:, None, :] & same_chain
+    identity = torch_module.eye(
+        residue_mask.shape[1], dtype=torch_module.bool, device=residue_mask.device
+    ).unsqueeze(0)
+    pair_valid = pair_valid & ~identity
+    density = torch_module.exp(-((distances / float(radius)) ** 2))
+    density = (density * pair_valid.to(density.dtype)).sum(dim=-1)
+
+    score = torch_module.zeros_like(density)
+    for batch_index in range(int(backbone.shape[0])):
+        for chain_id in torch_module.unique(chain_ids[batch_index][valid[batch_index]]):
+            local = valid[batch_index] & (chain_ids[batch_index] == chain_id)
+            values = density[batch_index][local]
+            if values.numel() == 1:
+                score[batch_index][local] = 0.0
+                continue
+            standardized = (values.mean() - values) / values.std(
+                unbiased=False
+            ).clamp_min(1e-6)
+            score[batch_index][local] = standardized.clamp(-3.0, 3.0)
+    return score.masked_fill(~valid, 0.0)
 
 
