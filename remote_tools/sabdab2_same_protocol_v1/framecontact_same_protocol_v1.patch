+def soft_dice_loss_per_complex(logits: Any, labels: Any, mask: Any) -> Any:
+    """Soft Dice on each complex, then equal-complex averaging."""
+    torch_module = _require_torch()
+    if (
+        tuple(logits.shape) != tuple(labels.shape)
+        or tuple(logits.shape) != tuple(mask.shape)
+    ):
+        raise ValueError("logits, labels, and mask must have identical shapes")
+    losses = []
+    for batch_index in range(int(logits.shape[0])):
+        local_mask = mask[batch_index]
+        probabilities = torch_module.sigmoid(logits[batch_index][local_mask])
+        targets = labels[batch_index][local_mask].to(probabilities.dtype)
+        if probabilities.numel() == 0:
+            raise ValueError("each complex must contain at least one observed label")
+        numerator = 2.0 * (probabilities * targets).sum() + 1e-6
+        denominator = probabilities.sum() + targets.sum() + 1e-6
+        losses.append(1.0 - numerator / denominator)
+    return torch_module.stack(losses).mean()
+
+
