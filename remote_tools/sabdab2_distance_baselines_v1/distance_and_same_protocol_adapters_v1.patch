+def balanced_multiclass_loss_per_complex(
+    logits: Any,
+    labels: Any,
+    mask: Any,
+) -> Any:
+    """Give every complex and every observed distance class equal mass."""
+    torch_module = _require_torch()
+    if logits.ndim != labels.ndim + 1 or tuple(logits.shape[:-1]) != tuple(labels.shape):
+        raise ValueError("multiclass logits must add one class axis to labels")
+    if tuple(labels.shape) != tuple(mask.shape) or mask.dtype != torch_module.bool:
+        raise ValueError("multiclass labels and boolean mask must align")
+    if not bool((((labels >= 0) & (labels < logits.shape[-1])) | ~mask).all()):
+        raise ValueError("observed multiclass labels are out of range")
+    losses = []
+    for batch_index in range(int(logits.shape[0])):
+        local_mask = mask[batch_index]
+        observed_logits = logits[batch_index][local_mask]
+        observed_labels = labels[batch_index][local_mask].long()
+        if observed_labels.numel() == 0:
+            raise ValueError("each complex must contain an observed distance label")
+        per_item = functional.cross_entropy(
+            observed_logits, observed_labels, reduction="none"
+        )
+        class_losses = [
+            per_item[observed_labels == class_index].mean()
+            for class_index in range(int(logits.shape[-1]))
+            if bool((observed_labels == class_index).any())
+        ]
+        losses.append(torch_module.stack(class_losses).mean())
+    return torch_module.stack(losses).mean()
+
+
+def residue_contrastive_alignment_loss(
+    sequence_view: Any,
+    geometry_view: Any,
+    mask: Any,
+    *,
+    temperature: float = 0.1,
+    maximum_residues: int = 256,
+) -> Any:
+    """Symmetric InfoNCE between matched sequence and geometry residue views."""
+    torch_module = _require_torch()
+    if (
+        tuple(sequence_view.shape) != tuple(geometry_view.shape)
+        or tuple(sequence_view.shape[:2]) != tuple(mask.shape)
+        or mask.dtype != torch_module.bool
+    ):
+        raise ValueError("contrastive residue views and mask must align")
+    sequence = sequence_view[mask]
+    geometry = geometry_view[mask]
+    if sequence.shape[0] > maximum_residues:
+        indices = torch_module.linspace(
+            0,
+            sequence.shape[0] - 1,
+            steps=maximum_residues,
+            device=sequence.device,
+        ).round().long()
+        sequence = sequence[indices]
+        geometry = geometry[indices]
+    if sequence.shape[0] < 2:
+        raise ValueError("contrastive alignment requires at least two residues")
+    sequence = functional.normalize(sequence.float(), dim=-1)
+    geometry = functional.normalize(geometry.float(), dim=-1)
+    similarity = sequence @ geometry.transpose(0, 1) / float(temperature)
+    targets = torch_module.arange(similarity.shape[0], device=similarity.device)
+    return 0.5 * (
+        functional.cross_entropy(similarity, targets)
+        + functional.cross_entropy(similarity.transpose(0, 1), targets)
+    )
+
